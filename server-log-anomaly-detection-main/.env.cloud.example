# Self-hosted Kafka in Docker
KAFKA_HOST=kafka
KAFKA_INTERNAL_PORT=9092
KAFKA_EXTERNAL_PORT=9094
KAFKA_BOOTSTRAP_SERVERS=localhost:9094
KAFKA_CONTROLLER_PORT=9093
KAFKA_BROKER_ID=1
KAFKA_PARTITIONS=3
KAFKA_REPLICATION_FACTOR=1
KAFKA_TOPIC_SERVER_LOGS=server-logs
KAFKA_TOPIC_ANOMALIES=anomalies
KAFKA_STARTING_OFFSETS=latest

# Self-hosted Elasticsearch in Docker
ELASTICSEARCH_HOST=elasticsearch
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_VERSION=8.15.3
ELASTICSEARCH_VERIFY_CERTS=false

# Spark
SPARK_APP_NAME=server-log-anomaly-detector
SPARK_LOG_LEVEL=WARN
SPARK_CHECKPOINT_LOCATION=/tmp/server-log-anomaly-checkpoint
SPARK_ELASTICSEARCH_ENABLED=true
SPARK_GPU_ENABLED=false
