{
  "index_patterns": ["anomalies-*"],
  "priority": 100,
  "template": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 0
    },
    "mappings": {
      "dynamic": "false",
      "properties": {
        "timestamp": { "type": "date" },
        "window_start": { "type": "date" },
        "window_end": { "type": "date" },
        "anomaly_type": { "type": "keyword" },
        "severity": { "type": "keyword" },
        "message": { "type": "text" },
        "client_ip": { "type": "ip" },
        "latency_ms": { "type": "float" },
        "mean_latency_ms": { "type": "float" },
        "stddev_latency_ms": { "type": "float" },
        "request_count": { "type": "long" },
        "error_count": { "type": "long" },
        "unauthorized_count": { "type": "long" },
        "error_rate": { "type": "float" },
        "event_count": { "type": "long" },
        "logger": { "type": "keyword" },
        "function": { "type": "keyword" },
        "source_file": { "type": "keyword" },
        "source_line": { "type": "integer" }
      }
    }
  }
}
